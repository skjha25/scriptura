# App
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:3000

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# MySQL
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# AI Providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# SerpAPI (optional — leave SERPAPI_ENABLED=false if not using yet)
SERPAPI_ENABLED=false
SERPAPI_KEY=

# Storage
STORAGE_DRIVER=local        # local | s3 (s3 stubbed for future use)
UPLOADS_DIR=./uploads

# ---------------------------------------------------------------------------
# Optional / advanced — every one of these has a working default.
# Nothing below needs to be set for the app to run.
# ---------------------------------------------------------------------------

# Token lifetimes
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=7d

# AI provider selection. The abstraction in src/services/ai is provider-agnostic:
#   anthropic -> text generation (titles, outlines, articles, brand voice)
#   openai    -> image generation
#   mock      -> deterministic canned responses, no network, no API key needed.
# `mock` is forced automatically when NODE_ENV=test.
# AI_TEXT_PROVIDER=anthropic
# AI_IMAGE_PROVIDER=openai

# Model overrides
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_IMAGE_MODEL=gpt-image-1

# Brand logo used by the sharp logo-overlay compositor.
# Path is relative to the backend directory. Swap in the real Divinetalk logo here.
# LOGO_PATH=./assets/logo.png

# Rate limiting (generation endpoints are limited separately and more tightly)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=300
# GENERATION_RATE_LIMIT_WINDOW_MS=3600000
# GENERATION_RATE_LIMIT_MAX=30

# S3 — only read when STORAGE_DRIVER=s3 (driver is stubbed, see StorageService)
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=
