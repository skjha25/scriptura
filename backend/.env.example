# App
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:3000

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# MySQL
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# AI Providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# SerpAPI (optional — leave SERPAPI_ENABLED=false if not using yet)
# Used for Fact Grounding and Keyword-first Autopilot Flow
SERPAPI_ENABLED=false
SERPAPI_KEY=

# Google Search Console (optional — leave GSC_ENABLED=false if not using yet)
# GSC_SITE_URL is the exact GSC property, e.g. sc-domain:example.com or https://example.com/
# GSC_SERVICE_ACCOUNT_KEY accepts EITHER the raw service-account JSON (single line,
# must start with "{") OR a filesystem path to the JSON key file — see config/index.js.
# The service account's client_email must be added as a user on the GSC property.
GSC_ENABLED=false
GSC_SITE_URL=
GSC_SERVICE_ACCOUNT_KEY=
# GSC_TIMEOUT_MS=20000

# Daily GSC sync cron job — automatic counterpart to the Settings page's
# "Sync now" button. On by default whenever GSC itself is enabled; each tick
# no-ops if GSC isn't configured. Independent flag so the daily job can be
# turned off (e.g. to conserve API quota) without disabling GSC entirely.
# GSC_SYNC_ENABLED=true
# GSC_SYNC_CRON=0 5 * * *
# GSC_SYNC_TIMEZONE=Asia/Kolkata

# Client publish-API integrations (Config page) — required ONLY to save or
# use a publishing_integrations credential (endpoint auth token/API key).
# Not needed at all if no client integration is configured. 32 bytes,
# base64-encoded, for AES-256-GCM. Generate with: openssl rand -base64 32
# Losing/rotating this key makes any already-saved credential undecryptable
# — back it up the same way you would any other production secret.
# CONFIG_ENCRYPTION_KEY=

# Storage
STORAGE_DRIVER=local        # local | s3 (s3 stubbed for future use)
UPLOADS_DIR=./uploads

# ---------------------------------------------------------------------------
# Optional / advanced — every one of these has a working default.
# Nothing below needs to be set for the app to run.
# ---------------------------------------------------------------------------

# Token lifetimes
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=7d

# AI provider selection. The abstraction in src/services/ai is provider-agnostic:
#   anthropic -> text generation (titles, outlines, articles, brand voice)
#   openai    -> image generation
#   mock      -> deterministic canned responses, no network, no API key needed.
# `mock` is forced automatically when NODE_ENV=test.
# AI_TEXT_PROVIDER=anthropic
# AI_IMAGE_PROVIDER=openai

# Model overrides
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_IMAGE_MODEL=gpt-image-1

# Brand logo used by the sharp logo-overlay compositor.
# Path is relative to the backend directory. Swap in the real Divinetalk logo here.
# LOGO_PATH=./assets/logo.png

# Rate limiting (generation endpoints are limited separately and more tightly)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=300
# GENERATION_RATE_LIMIT_WINDOW_MS=3600000
# GENERATION_RATE_LIMIT_MAX=30

# S3 — only read when STORAGE_DRIVER=s3 (driver is stubbed, see StorageService)
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=

# Scheduled-publish cron job — flips SCHEDULED blogs to PUBLISHED once
# publish_date has passed and generation has completed. Runs in-process
# (node-cron), disabled automatically under NODE_ENV=test.
# SCHEDULER_ENABLED=true
# SCHEDULER_CRON=* * * * *
# SCHEDULER_TIMEZONE=Asia/Kolkata
